generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  AI_ENGINEER
  SEO_SPECIALIST
  CONTENT_EDITOR
  VIEWER
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  BLOG
  LEGAL
}

model User {
  id              String     @id @default(cuid())
  name            String?
  email           String     @unique
  password        String     // Stores the bcrypt hashed password
  role            Role       @default(VIEWER)
  assignedPillars String
  is2FAEnabled    Boolean    @default(false)
  totpSecret      String?
  image           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  auditLogs       AuditLog
}

model LotteryCategory {
  id              String       @id @default(cuid())
  name            String       @unique
  slug            String       @unique
  drawSchedule    Json
  isActive        Boolean      @default(true)
  predictions     Prediction
  pillarPage      PillarPage?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Prediction {
  id                String          @id @default(cuid())
  lotteryCategory   LotteryCategory @relation(fields: [lotteryCategoryId], references: [id], onDelete: Cascade)
  lotteryCategoryId String
  drawDate          DateTime
  mainNumbers       String
  hotNumbers        String
  coldNumbers       String
  overdueNumbers    String
  historyLogs       Json            @default("")
  scientificNote    String?
  status            PostStatus      @default(DRAFT)
  publishedAt       DateTime?
  scheduledFor      DateTime?
  seo               PredictionSeo?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PredictionSeo {
  id             String     @id @default(cuid())
  prediction     Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  predictionId   String     @unique
  title          String
  description    String
  focusKeyphrase String
  canonicalUrl   String
  seoScore       Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model PillarPage {
  id                String          @id @default(cuid())
  lotteryCategory   LotteryCategory @relation(fields: [lotteryCategoryId], references: [id], onDelete: Cascade)
  lotteryCategoryId String          @unique
  layoutBlocks      Json            @default("")
  seo               PillarPageSeo?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PillarPageSeo {
  id             String     @id @default(cuid())
  pillarPage     PillarPage @relation(fields: [pillarPageId], references: [id], onDelete: Cascade)
  pillarPageId   String     @unique
  title          String
  description    String
  focusKeyphrase String
  canonicalUrl   String
  seoScore       Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// --- NEW PHASE 3 MODELS START ---
model Category {
  id          String              @id @default(cuid())
  name        String              @unique @db.VarChar(100)
  posts       CategoriesOnPosts
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  @@map("categories")
}

model Tag {
  id          String        @id @default(cuid())
  name        String        @unique @db.VarChar(100)
  posts       TagsOnPosts
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("tags")
}

model CategoriesOnPosts {
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  assignedAt  DateTime @default(now())

  @@id([postId, categoryId])
  @@index([categoryId])
  @@map("categories_on_posts")
}

model TagsOnPosts {
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId       String
  assignedAt  DateTime @default(now())

  @@id([postId, tagId])
  @@index([tagId])
  @@map("tags_on_posts")
}
// --- NEW PHASE 3 MODELS END ---

model Post {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  featuredImage String?
  content       Json        @default("{}")
  contentType   ContentType @default(BLOG)
  status        PostStatus  @default(DRAFT)
  publishedAt   DateTime?
  seo           PostSeo?
  
  categories    CategoriesOnPosts
  tags          TagsOnPosts

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Composite index to speed up the default admin view
  @@index([status, publishedAt])
  @@map("posts")
}

model PostSeo {
  id             String   @id @default(cuid())
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String   @unique
  title          String
  description    String
  focusKeyphrase String
  canonicalUrl   String
  seoScore       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([seoScore])
  @@map("post_seo")
}

model Expert {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  bio            String
  avatarUrl      String?
  credentials    String
  authorityLinks String
  isApproved     Boolean  @default(false)
  isVisible      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Redirect {
  id             String   @id @default(cuid())
  sourceUrl      String   @unique
  destinationUrl String
  statusCode     Int      @default(301)
  clicks         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  entity    String
  entityId  String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}